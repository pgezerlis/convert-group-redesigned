# Contact form — copy to .env for local testing; set the same names as secrets in the hosting environment.

# Public reCAPTCHA v3 site key (ships to the browser). Register convertgroup.com, convertgroup.ai and localhost.
VITE_RECAPTCHA_SITE_KEY=

# Server-only secrets — never prefix these with VITE_.
RECAPTCHA_SECRET_KEY=
# Google service account with domain-wide delegation for https://www.googleapis.com/auth/gmail.send
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The "private_key" value from the service account JSON key, including the BEGIN/END lines (\n escapes are fine).
GOOGLE_SERVICE_ACCOUNT_KEY=

# Optional overrides (server-only).
# CONTACT_SENDER=itservices@convertgroup.com
# CONTACT_TO=bizdev@convertgroup.com
# RECAPTCHA_MIN_SCORE=0.5
